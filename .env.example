# Supabase (Project settings > API). Use the publishable key, never the secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public site URL, used for magic link and Google sign-in redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown on the privacy policy page as the contact for data requests.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- AI explanations via OpenRouter (optional; AI is off when the key is empty) ---
OPENROUTER_API_KEY=
# Comma-separated free models, tried in order. Free model ids end in ":free".
OPENROUTER_FREE_MODELS=
# One low-cost paid model, used only when every free model fails.
OPENROUTER_PAID_MODEL=
# Set to true to allow the paid fallback at all.
OPENROUTER_ALLOW_PAID=false
# Free models usually need "allow providers that may train on inputs" turned on in
# your OpenRouter privacy settings. Set to true only if you accept that. We only
# ever send anonymised, rounded numbers.
OPENROUTER_FREE_ALLOW_DATA_COLLECTION=false
# Max AI requests per user per day.
AI_DAILY_LIMIT=20

# --- Statement import ---
# Local only: where `next dev` sends /api/cas_parse. Run the reader with
#   python3 -m venv .venv-cas && .venv-cas/bin/pip install -r requirements.txt
#   .venv-cas/bin/python scripts/cas_dev_server.py
# Leave unset on Vercel, where api/cas_parse.py runs as a Python function.
CAS_PARSER_DEV_URL=
